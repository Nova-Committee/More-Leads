{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Nova-Committee",
        "sources": "https://github.com/Nova-Committee/more-leads"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "committee.nova.mods.moreleads.fabric.MoreLeadsFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "accessWidener": "${mod_id}.accesswidener",
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": ">=1.21",
        "java": ">=17"
    },
    "custom": {
        "loom:injected_interfaces": {
            "net/minecraft/class_1657": ["net/minecraft/world/entity/Leashable"]
        }
    }
}
