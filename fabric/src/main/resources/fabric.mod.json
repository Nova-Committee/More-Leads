{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Nova-Committee/more-leads"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "committee.nova.mods.moreleads.MoreLeadsFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version_range}"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1690": [
        "committee/nova/mods/moreleads/api/ILeash"
      ]
    }
  }
}
